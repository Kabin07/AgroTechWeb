# Copy to .env.local and fill in. Restart `npm start` after changes.
# Without the Supabase values the app runs in on-device DEMO MODE.

# Supabase → Project Settings → API
REACT_APP_SUPABASE_URL=https://<project-ref>.supabase.co
REACT_APP_SUPABASE_ANON_KEY=<anon or publishable key>

# Optional, demo mode only: lets the browser fetch live mandi prices directly.
# In Supabase mode set DATA_GOV_API_KEY as an Edge Function secret instead.
REACT_APP_DATA_GOV_API_KEY=
